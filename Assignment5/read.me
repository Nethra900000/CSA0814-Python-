# B2.3 – ADVERSARIAL SENTIMENT TESTING
# =====================================================

print("\n" + "=" * 55)
print("B2.3 – ADVERSARIAL SENTIMENT TESTING")
print("=" * 55)

positive_words = {
    "good", "excellent", "clean",
    "better", "love", "improved"
}

negative_words = {
    "bad", "poor", "dirty",
    "terrible", "polluted", "dangerous"
}

negation_words = {"not", "never", "no"}


def sentiment(text):

    words = re.findall(
        r"\b[\w']+\b",
        text.lower()
    )

    positive = 0
    negative = 0

    for i, word in enumerate(words):

        negated = (
            i > 0 and
            words[i - 1] in negation_words
        )

        if word in positive_words:

            if negated:
                negative += 1
            else:
                positive += 1

        elif word in negative_words:

            if negated:
                positive += 1
            else:
                negative += 1

    if positive > negative:
        return "Positive"

    elif negative > positive:
        return "Negative"

    else:
        return "Neutral"


