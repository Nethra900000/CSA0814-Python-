# =====================================================
# B2.1 – ADVERSARIAL CSV TESTING
# =====================================================

def test_csv(data, delimiter=",", encoding="utf-8"):
    try:
        # Decode byte data using the specified encoding
        if isinstance(data, bytes):
            data = data.decode(encoding)

        if not data:
            print("Error: CSV file is empty")
            return

        reader = csv.DictReader(
            io.StringIO(data),
            delimiter=delimiter
        )

        required = {"station", "date", "pm25"}

        if reader.fieldnames is None:
            print("Error: Empty CSV file")
            return

        if not required.issubset(set(reader.fieldnames)):
            print("Error: Required column missing")
            return

        rows = list(reader)

        if not rows:
            print("Error: No data records found")
            return

        print("CSV loaded successfully:", rows)

    except UnicodeDecodeError:
        print("Error: Unable to decode CSV using", encoding)

    except Exception as e:
        print("Error:", e)


print("=" * 55)
print("B2.1 – ADVERSARIAL CSV TESTING")
print("=" * 55)

print("\nTest 1: Missing PM2.5 column")
test_csv(
    "station,date\n"
    "Adyar,2026-10-01\n"
)

print("\nTest 2: Semicolon delimiter")
test_csv(
    "station;date;pm25\n"
    "Adyar;2026-10-01;48\n"
)

print("\nTest 3: UTF-16 encoding")
utf16_data = (
    "station,date,pm25\n"
    "Adyar,2026-10-01,48\n"
).encode("utf-16")

test_csv(utf16_data, encoding="utf-16")

print("\nTest 4: Empty file")
test_csv("")


