# Daily Rainfall Records

random.seed(10)
readings = [random.randint(0, 50) for _ in range(365)]

weekly_totals = [
    sum(readings[i:i + 7])
    for i in range(0, len(readings), 7)
]

maximum = max(readings)
minimum = min(readings)

def moving_average_naive(data):
    return [
        sum(data[i:i + 7]) / 7
        for i in range(len(data) - 6)
    ]

def moving_average_running(data):
    if len(data) < 7:
        return []

    averages = []
    current_sum = sum(data[:7])
    averages.append(current_sum / 7)

    for i in range(7, len(data)):
        current_sum += data[i] - data[i - 7]
        averages.append(current_sum / 7)

    return averages

dry_days = [
    i + 1 for i, value in enumerate(readings)
    if value == 0
]

print("Weekly totals:", weekly_totals)
print("Maximum rainfall:", maximum)
print("Maximum day:", readings.index(maximum) + 1)
print("Minimum rainfall:", minimum)
print("Minimum day:", readings.index(minimum) + 1)
print("Dry days:", dry_days)
print("Naive moving average:", moving_average_naive(readings)[:5])
print("Running sum average:", moving_average_running(readings)[:5])


