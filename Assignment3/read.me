def search_station(trains, station, day):
    results = []

    for train_no, details in trains.items():
        if day not in details["days"]:
            continue

        for name, arrival, departure in details["stations"]:
            if name == station:
                results.append(
                    (train_no, details["name"], arrival, departure)
                )

    return sorted(results, key=lambda x: x[3])

def create_station_index(trains):
    index = {}

    for train_no, details in trains.items():
        for station, arrival, departure in details["stations"]:
            index.setdefault(station, []).append(
                (train_no, details["name"], arrival,
                 departure, details["days"])
            )

    return index

def search_with_index(index, station, day):
    results = []

    for train_no, name, arrival, departure, days in index.get(station, []):
        if day in days:
            results.append((train_no, name, arrival, departure))

    return sorted(results, key=lambda x: x[3])

station_index = create_station_index(trains)
station = "Chennai"
day = "Monday"

print("\nTrains without index:")
print(search_station(trains, station, day))

print("\nTrains with index:")
print(search_with_index(station_index, station, day))


# Contact Normalisation and Merging

def normalise_phone(phone):
    digits = "".join(ch for ch in phone if ch.isdigit())

    if len(digits) == 12 and digits.startswith("91"):
        digits = digits[2:]

    return digits

def normalise_name(name):
    return " ".join(name.casefold().split())

def normalise_email(email):
    return email.strip().casefold()

class UnionFind:
    def __init__(self):
        self.parent = {}

    def find(self, x):
        if x not in self.parent:
            self.parent[x] = x

        if self.parent[x] != x:
            self.parent[x] = self.find(self.parent[x])

        return self.parent[x]

    def union(self, a, b):
        root_a = self.find(a)
        root_b = self.find(b)

        if root_a != root_b:
            self.parent[root_b] = root_a

def merge_contacts(contacts):
    uf = UnionFind()
    processed = []

    for contact in contacts:
        name = contact.get("name", "").strip()

        phones = {
            normalise_phone(p)
            for p in contact.get("phones", [])
            if normalise_phone(p)
        }

        emails = {
            normalise_email(e)
            for e in contact.get("emails", [])
            if normalise_email(e)
        }

        processed.append({
            "name": name,
            "phones": phones,
            "emails": emails
        })

        identifiers = (
            {"P:" + p for p in phones}
            | {"E:" + e for e in emails}
        )

        if identifiers:
            first = next(iter(identifiers))

            for identifier in identifiers:
                uf.union(first, identifier)

    merged = {}

    for contact in processed:
        identifiers = (
            {"P:" + p for p in contact["phones"]}
            | {"E:" + e for e in contact["emails"]}
        )

        if identifiers:
            root = uf.find(next(iter(identifiers)))
        else:
            root = "EMPTY:" + str(id(contact))

        if root not in merged:
            merged[root] = {
                "names": set(),
                "phones": set(),
                "emails": set()
            }

        if contact["name"]:
            merged[root]["names"].add(contact["name"])

        merged[root]["phones"].update(contact["phones"])
        merged[root]["emails"].update(contact["emails"])

    return list(merged.values())

