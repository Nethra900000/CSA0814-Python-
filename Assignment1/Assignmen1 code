from decimal import Decimal, ROUND_HALF_UP
import math

# Constants
BASE_RATE = 30.00
FAT_STEP_VALUE = 0.40
SNF_STEP_VALUE = 0.30

STD_FAT = 3.5
STD_SNF = 8.5
STEP = 0.1

MIN_FAT = 2.0
MAX_FAT = 7.0
MIN_SNF = 6.0
MAX_SNF = 10.0

SHIFTS = ("M", "E")


# Validate milk entry
def is_valid(farmer_id, litres, fat, snf, shift):
    try:
        farmer_id = int(farmer_id)
        litres = float(litres)
        fat = float(fat)
        snf = float(snf)
    except (ValueError, TypeError):
        return False

    return (
        farmer_id > 0
        and litres > 0
        and MIN_FAT <= fat <= MAX_FAT
        and MIN_SNF <= snf <= MAX_SNF
        and shift in SHIFTS
    )


# Calculate rate per litre
def rate_per_litre(fat, snf):
    fat_steps = round((fat - STD_FAT) / STEP)
    snf_steps = round((snf - STD_SNF) / STEP)

    rate = (
        BASE_RATE
        + fat_steps * FAT_STEP_VALUE
        + snf_steps * SNF_STEP_VALUE
    )

    return round(rate, 2)


# Calculate payment
def payout(litres, fat, snf):
    return round(litres * rate_per_litre(fat, snf), 2)


# Calculate total payment
def ten_day_total(entries):
    total = 0.0

    for litres, fat, snf in entries:
        total += payout(litres, fat, snf)

    return round(total, 2)


# Read and convert input
def read_number(text):
    try:
        return float(text)
    except ValueError:
        return None


# Decimal calculations
def decimal_total(payments):
    total = Decimal("0")

    for amount in payments:
        total += Decimal(str(amount))

    return total


# Validate an entry
def valid_entry(litres, fat, snf):
    try:
        litres = float(litres)
        fat = float(fat)
        snf = float(snf)
    except (ValueError, TypeError):
        return False

    return (
        litres > 0
        and MIN_FAT <= fat <= MAX_FAT
        and MIN_SNF <= snf <= MAX_SNF
    )


# Seasonal rate cards
RATE_CARDS = {
    "normal": {
        "base": Decimal("30.00"),
        "fat_step": Decimal("0.40"),
        "snf_step": Decimal("0.30")
    },
    "apr_jun": {
        "base": Decimal("32.00"),
        "fat_step": Decimal("0.45"),
        "snf_step": Decimal("0.30")
    }
}

BONUS_LIMIT_LITRES = Decimal("500")
BONUS_PER_LITRE = Decimal("0.50")


def money(value):
    return value.quantize(
        Decimal("0.01"),
        rounding=ROUND_HALF_UP
    )


def seasonal_rate(fat, snf, season="normal"):
    card = RATE_CARDS[season]

    fat_steps = (
        Decimal(str(fat)) - Decimal("3.5")
    ) / Decimal("0.1")

    snf_steps = (
        Decimal(str(snf)) - Decimal("8.5")
    ) / Decimal("0.1")

    rate = (
        card["base"]
        + fat_steps * card["fat_step"]
        + snf_steps * card["snf_step"]
    )

    return money(rate)


def seasonal_payout(litres, fat, snf, season="normal"):
    rate = seasonal_rate(fat, snf, season)
    return money(Decimal(str(litres)) * rate)


def bonus(total_litres):
    litres = Decimal(str(total_litres))

    if litres > BONUS_LIMIT_LITRES:
        return money(litres * BONUS_PER_LITRE)

    return Decimal("0.00")


def seasonal_total(entries, season="normal"):
    total_litres = sum(
        (Decimal(str(entry[0])) for entry in entries),
        Decimal("0")
    )

    payment = sum(
        (
            seasonal_payout(l, f, s, season)
            for l, f, s in entries
        ),
        Decimal("0")
    )

    extra = bonus(total_litres)

    return total_litres, payment, extra, payment + extra


