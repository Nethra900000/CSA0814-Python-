print("Customer 3:", customer3)


def bill(price, quantity=1, gst_rate=0.05):
    subtotal = price * quantity
    gst = subtotal * gst_rate
    total = subtotal + gst
    return total, gst


total, gst = bill(50, quantity=2, gst_rate=0.05)

print("Total:", total)
print("GST:", gst)

