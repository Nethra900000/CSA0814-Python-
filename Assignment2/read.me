def show_local():
    count = 3
    print("Local count:", count)


def increase_global():
    global count
    count += 1


def outer():
    value = 5

    def inner():
        nonlocal value
        value += 1

    inner()
    return value


show_local()
increase_global()

print("Global count:", count)
print("Nonlocal value:", outer())
