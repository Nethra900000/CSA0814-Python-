def verify_otp(correct_otp, entries):
    attempts = 0

    for entered in entries:
        if attempts >= 3:
            break

        if entered.strip() == "":
            continue

        if entered == correct_otp:
            print("OTP verified successfully.")
            break

        attempts += 1
        print("Incorrect OTP. Attempts:", attempts)
    else:
        print("Account locked for 30 minutes.")


def verify_otp_for(correct_otp, entries):
    index = 0

    for attempt in range(3):
        while index < len(entries):
            entered = entries[index]
            index += 1

            if entered.strip() != "":
                break

            print("Blank entry. Please try again.")
        else:
            print("No more entries.")
            return

        if entered == correct_otp:
            print("OTP verified successfully.")
            break

        print("Incorrect OTP. Attempts:", attempt + 1)
    else:
        print("Account locked for 30 minutes.")


verify_otp("123456", ["", "111111", "222222", "333333"])
verify_otp_for("123456", ["111111", "222222", "333333"])
verify_otp("123456", ["123456"])


def normalise(text):
    text = text.strip()
    text = text.replace(" ", "")
    text = text.replace("-", "")
    return text.upper()


def is_valid(reg):
    if len(reg) not in (9, 10):
        return False

    state = reg[0:2]
    district = reg[2:4]
    series = reg[4:-4]
    number = reg[-4:]

    return (
        state.isalpha()
        and district.isdigit()
        and len(series) in (1, 2)
        and series.isalpha()
        and number.isdigit()
    )


def format_number(reg):
    if not is_valid(reg):
        return "INVALID"

    return reg[0:2] + " " + reg[2:4] + " " + reg[4:-4] + " " + reg[-4:]


