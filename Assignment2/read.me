def subsidy_separate(units, ration_card, age):
    result = []

    if units <= 100:
        result.append("Full Subsidy")

    if 101 <= units <= 200 and ration_card:
        result.append("Partial Subsidy")

    if units > 200 and age > 80:
        result.append("Senior Citizen Subsidy")

    if not result:
        result.append("No Subsidy")

    return result


def subsidy_elif(units, ration_card, age):
    if units <= 100:
        return "Full Subsidy"
    elif 101 <= units <= 200 and ration_card:
        return "Partial Subsidy"
    elif units > 200 and age > 80:
        return "Senior Citizen Subsidy"
    else:
        return "No Subsidy"


def subsidy_match(units, ration_card, age):
    match units:
        case n if n <= 100:
            return "Full Subsidy"
        case n if 101 <= n <= 200 and ration_card:
            return "Partial Subsidy"
        case n if n > 200 and age > 80:
            return "Senior Citizen Subsidy"
        case _:
            return "No Subsidy"


