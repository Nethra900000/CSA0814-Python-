def build_plus(parts):
    text = ""
    for p in parts:
        text += p + ";"
    return text


def build_join(parts):
    return ";".join(parts) + ";"


def build_fstring(records):
    parts = [f"Item{i}:Rs{i % 50}" for i in range(records)]
    return ";".join(parts) + ";"


def measure(function, argument):
    times = []

    for i in range(3):
        start = time.perf_counter()
        result = function(argument)
        end = time.perf_counter()
        times.append(end - start)

    return result, mean(times)


for size in (1000, 10000, 200000):
    items = [f"Item{i}:Rs{i % 50}" for i in range(size)]

    a, t_plus = measure(build_plus, items)
    b, t_join = measure(build_join, items)

    start = time.perf_counter()
    c = build_fstring(size)
    t_fstring = time.perf_counter() - start

    print("Records:", size)
    print("Same output:", a == b == c)
    print("Length:", len(b))
    print("Average += time:", round(t_plus, 6), "seconds")
    print("Average join time:", round(t_join, 6), "seconds")
    print("F-string + join time:", round(t_fstring, 6), "seconds")


def add_item_buggy(item, order=[]):
    order.append(item)
    return order


def add_item(item, order=None):
    if order is None:
        order = []

    order.append(item)
    return order


