calls = 0


def ways_naive(n):
    global calls
    calls += 1

    if n <= 1:
        return 1

    return ways_naive(n - 1) + ways_naive(n - 2)


@lru_cache(maxsize=None)
def ways_memo(n):
    global calls
    calls += 1

    if n <= 1:
        return 1

    return ways_memo(n - 1) + ways_memo(n - 2)


def ways_loop(n):
    if n <= 1:
        return 1

    previous_two = 1
    previous_one = 1

    for i in range(2, n + 1):
        current = previous_two + previous_one
        previous_two = previous_one
        previous_one = current

    return previous_one


for n in range(1, 7):
    print(n, ways_loop(n))

calls = 0
print("Naive:", ways_naive(25), "calls =", calls)

calls = 0
ways_memo.cache_clear()

print("Memo:", ways_memo(25), "calls =", calls)

print("Recursion limit:", sys.getrecursionlimit())

ways_memo.cache_clear()

try:
    print("Memoised result:", ways_memo(1000))
except RecursionError:
    print("RecursionError: Recursion depth limit reached")

print("Loop result:", ways_loop(1000))


original_calls = 0


def original_naive(n):
